# ==============================================================================
# MalagaMicro CRM — Variables del FRONTEND
# Copia este archivo como `.env` y rellena los valores de tu propio backend.
# Estas tres variables se inyectan en el bundle durante `npm run build`.
# Son claves PÚBLICAS (anon/publishable): nunca pongas aquí claves de servicio.
# ==============================================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_PROJECT_ID=tu-project-id

# Puerto en el que se publicará el CRM con Docker Compose
CRM_PORT=8081
