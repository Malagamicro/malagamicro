# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — CRM MALAGAMICRO
# Copia este archivo a `.env` en la raíz del proyecto para el Frontend (Vite)
# y configura las claves de backend en Supabase Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vite / Client Side)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 2. EDGE FUNCTIONS (Supabase Secrets)
# Configura estas variables ejecutando: `npx supabase secrets set NOMBRE=VALOR`
# ------------------------------------------------------------------------------

# -- OpenAI API Key (para chatbots, resúmenes e IA de correos) --
OPENAI_API_KEY=sk-proj-...

# -- Perplexity AI (para buscador inteligente y prospección) --
PERPLEXITY_API_KEY=pplx-...

# -- WAHA WhatsApp HTTP API (Instancia propia Docker) --
WAHA_API_URL=http://tu-vps-ip:3000
WAHA_API_KEY=tu_clave_secreta_waha
WAHA_SESSION_ID=default

# -- n8n Automation Workflows (Webhook URL) --
N8N_WEBHOOK_URL=https://tu-n8n.ejemplo.com/webhook/crm-lead-update
N8N_API_KEY=n8n_api_key_...

# -- osTicket Integration --
OSTICKET_API_URL=https://soporte.tu-empresa.com/api/tickets.json
OSTICKET_API_KEY=YOUR_OSTICKET_API_KEY

# -- StelOrder Integration --
STELORDER_API_KEY=stel_...

# -- SMTP Email Sending (Profiles Fallback) --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tu-empresa.com
SMTP_PASS=tu_password_de_aplicacion
